@model IEnumerable<PDFsignture.Models.Document>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My PDF Documents</h2>
    <a asp-action="Upload" class="btn btn-success">Upload New PDF</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>File Name</th>
            <th>Upload Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FileName</td>
                <td>@item.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <div class="btn-group">
                        <a asp-action="ViewPdf" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-controller="Signature" asp-action="Sign" asp-route-docId="@item.Id" class="btn btn-sm btn-primary">Sign Now</a>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No documents found. Start by uploading one!</td>
            </tr>
        }
    </tbody>
</table>