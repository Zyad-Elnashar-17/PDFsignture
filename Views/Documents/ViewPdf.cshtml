@model PDFsignture.Models.Document

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    <a asp-controller="Signature" asp-action="Sign" asp-route-docId="@Model.Id" class="btn btn-primary">Proceed to Sign</a>
</div>

<div class="card">
    <div class="card-header bg-dark text-white">
        Viewing: @Model.FileName
    </div>
    <div class="card-body p-0">
        <!-- Using iframe to display PDF -->
        <iframe src="@Model.FilePath" width="100%" height="800px" style="border: none;">
            Your browser does not support iframes.
            <a href="@Model.FilePath">Click here to download the PDF</a>
        </iframe>
    </div>
</div>