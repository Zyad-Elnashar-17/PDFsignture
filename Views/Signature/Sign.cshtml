@using System.Security.Claims
@model PDFsignture.ViewModels.SignProcessVM
@inject PDFsignture.Interfaces.ISignatureRepository SigRepo

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var userSignatures = await SigRepo.GetUserSignaturesAsync(userId);
}

<h2 class="mb-4">Sign Document</h2>

<div class="row">
    <!-- Left Side: Configuration -->
    <div class="col-md-4">
        <form asp-action="ProcessSigning" method="post" class="card p-3 shadow-sm">
            <input type="hidden" asp-for="DocumentId" />

            <!-- 1. Select Signature -->
            <div class="mb-3">
                <label class="form-label fw-bold">1. Select Your Signature</label>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var sig in userSignatures)
                    {
                        <div class="signature-option">
                            <input type="radio" asp-for="SignatureId" value="@sig.Id" id="sig-@sig.Id" class="btn-check" required>
                            <label class="btn btn-outline-secondary p-1" for="sig-@sig.Id">
                                <img src="@sig.SignatureImagePath" width="80" alt="Signature" />
                                <div class="small text-muted">@sig.CreatedAt.ToString("MM/yyyy")</div>
                            </label>
                        </div>
                    }
                </div>
                <a asp-action="Create" class="btn btn-sm btn-outline-primary">+ Create New Signature</a>
            </div>

            <hr />

            <!-- 2. Select Pages -->
            <div class="mb-3">
                <label class="form-label fw-bold">2. Which pages to sign?</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="SignAllPages" value="true" id="allPages" checked>
                    <label class="form-check-label" for="allPages">All Pages</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="SignAllPages" value="false" id="specificPages">
                    <label class="form-check-label" for="specificPages">Specific Pages</label>
                </div>
                <input asp-for="SpecificPages" class="form-control form-control-sm mt-2" placeholder="e.g. 1,3,5" />
            </div>

            <hr />

            <!-- 3. Position -->
            <div class="mb-3">
                <label class="form-label fw-bold">3. Signature Position</label>
                <select asp-for="Position" class="form-select">
                    <option value="Bottom">Bottom Right</option>
                    <option value="Top">Top Right</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2">Apply Signature & Save</button>
        </form>
    </div>

    <!-- Right Side: PDF Preview -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-secondary text-white">Document Preview</div>
            <div class="card-body p-0">
                <iframe src="@ViewBag.DocumentPath" width="100%" height="600px"></iframe>
            </div>
        </div>
    </div>
</div>

<style>
    .signature-option .btn-check:checked + label {
        border-color: #198754;
        background-color: #f8fffb;
        box-shadow: 0 0 5px rgba(25, 135, 84, 0.5);
    }
</style>